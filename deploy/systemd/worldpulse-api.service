[Unit]
Description=WorldPulse AI FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=worldpulse
Group=worldpulse
WorkingDirectory=/opt/worldpulse-ai/backend
EnvironmentFile=/etc/worldpulse/worldpulse.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/worldpulse-ai/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
